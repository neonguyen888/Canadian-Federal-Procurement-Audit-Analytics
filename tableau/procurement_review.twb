        <cols>[awards].[none:c_year_short:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Card: observed">
      <table>
        <view>
          <datasources>
            <datasource caption="Bunching summary" name="bunch" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="bunch">
            <column caption="Observed" datatype="real" default-format="n#,##0" name="[c_obs]" role="measure" type="quantitative">
              <calculation class="tableau" formula="MAX(IIF([group] = &quot;all&quot;, [observed], NULL))" />
            </column>
            <column caption="Expected" datatype="real" default-format="n#,##0" name="[c_exp]" role="measure" type="quantitative">
              <calculation class="tableau" formula="MAX(IIF([group] = &quot;all&quot;, [expected], NULL))" />
            </column>
            <column caption="Chosen commodity" datatype="boolean" name="[c_param]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[commodity_type] = [Parameters].[p_commodity]" />
            </column>
            <column caption="Kind" datatype="string" name="[limit_kind]" role="dimension" type="nominal" />
            <column-instance column="[c_obs]" derivation="User" name="[usr:c_obs:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_exp]" derivation="User" name="[usr:c_exp:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_param]" derivation="None" name="[none:c_param:nk]" pivot="key" type="nominal" />
            <column-instance column="[limit_kind]" derivation="None" name="[none:limit_kind:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Commodity" datatype="string" name="[p_commodity]" param-domain-type="list" role="measure" type="nominal" value="&quot;S&quot;" alias="Services">
              <calculation class="tableau" formula="&quot;S&quot;" />
              <aliases>
                <alias key="&quot;C&quot;" value="Construction" />
                <alias key="&quot;G&quot;" value="Goods" />
                <alias key="&quot;S&quot;" value="Services" />
              </aliases>
              <members>
                <member alias="Services" value="&quot;S&quot;" />
                <member alias="Goods" value="&quot;G&quot;" />
                <member alias="Construction" value="&quot;C&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[bunch].[none:c_param:nk]">
            <groupfilter function="member" level="[none:c_param:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[bunch].[none:limit_kind:nk]">
            <groupfilter function="member" level="[none:limit_kind:nk]" member="&quot;real&quot;" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="worksheet">
