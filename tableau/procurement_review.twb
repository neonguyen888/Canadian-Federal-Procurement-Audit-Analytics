              <text column="[awards].[Multiple Values]" />
              <color column="[awards].[:Measure Names]" />
              <lod column="[awards].[none:award_reference:nk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run bold="true" fontsize="9">#&lt;[awards].[none:risk_rank:ok]&gt; &lt;[awards].[none:department:nk]&gt;
</run>
