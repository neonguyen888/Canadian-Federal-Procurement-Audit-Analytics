    <worksheet name="Flag rate by department">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f2f5" fontsize="13" fontname="Tableau Semibold">Flag rate by department, against the 15.2% average
</run>
            <run fontcolor="#a3a3b0" fontsize="9">The eight departments with the most flagged awards. Yellow: above the average.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Awards" name="awards" />
          </datasources>
          <datasource-dependencies datasource="awards">
            <column caption="Fiscal year" datatype="string" name="[fiscal_year]" role="dimension" type="nominal" />
            <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
            <column caption="Department" datatype="string" name="[department]" role="dimension" type="nominal" />
            <column caption="Flag rate" datatype="real" default-format="p0.0%" name="[c_flag_rate]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_flagged]) / COUNT([award_reference])" />
            </column>
            <column caption="Flagged" datatype="integer" default-format="n#,##0" name="[is_flagged]" role="measure" type="quantitative" />
            <column caption="Overall flag rate" datatype="real" default-format="p0.0%" name="[c_overall_rate]" role="measure" type="quantitative">
              <calculation class="tableau" formula="{FIXED : SUM([is_flagged])} / {FIXED : COUNT([award_reference])}" />
            </column>
            <column caption="Above the average" datatype="real" default-format="p0.0%" name="[c_rate_above]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF([c_flag_rate] &gt; AVG([c_overall_rate]), [c_flag_rate], NULL)" />
            </column>
            <column caption="At or below the average" datatype="real" default-format="p0.0%" name="[c_rate_below]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF([c_flag_rate] &lt;= AVG([c_overall_rate]), [c_flag_rate], NULL)" />
            </column>
            <column-instance column="[fiscal_year]" derivation="None" name="[none:fiscal_year:nk]" pivot="key" type="nominal" />
            <column-instance column="[commodity]" derivation="None" name="[none:commodity:nk]" pivot="key" type="nominal" />
            <column-instance column="[department]" derivation="None" name="[none:department:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_flag_rate]" derivation="User" name="[usr:c_flag_rate:qk]" pivot="key" type="quantitative" />
            <column-instance column="[is_flagged]" derivation="Sum" name="[sum:is_flagged:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_overall_rate]" derivation="Avg" name="[avg:c_overall_rate:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_rate_above]" derivation="User" name="[usr:c_rate_above:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_rate_below]" derivation="User" name="[usr:c_rate_below:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[awards].[none:fiscal_year:nk]" context="true" filter-group="2">
            <groupfilter function="level-members" level="[none:fiscal_year:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:commodity:nk]" context="true" filter-group="4">
            <groupfilter function="level-members" level="[none:commodity:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:department:nk]">
            <groupfilter count="8" end="top" function="end" units="records" user:ui-marker="end" user:ui-top-by-field="true">
              <groupfilter direction="DESC" expression="SUM([is_flagged])" function="order" user:ui-marker="order">
                <groupfilter function="level-members" level="[none:department:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
              </groupfilter>
            </groupfilter>
          </filter>
          <filter class="categorical" column="[awards].[:Measure Names]">
            <groupfilter function="union" user:op="manual">
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[usr:c_rate_above:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[usr:c_rate_below:qk]&quot;" />
            </groupfilter>
          </filter>
          <sort class="computed" column="[awards].[none:department:nk]" direction="DESC" using="[awards].[sum:is_flagged:qk]" />
          <sort class="manual" column="[awards].[:Measure Names]" direction="ASC">
            <dictionary>
              <bucket>"[awards].[usr:c_rate_above:qk]"</bucket>
              <bucket>"[awards].[usr:c_rate_below:qk]"</bucket>
            </dictionary>
          </sort>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#2a2a33" />
