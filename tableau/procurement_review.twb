            <column caption="Sole-sourced share" datatype="real" default-format="p0.0%" name="[c_sole_share]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IIF([competition] = &quot;Sole-sourced&quot;, 1, 0)) / COUNT([award_reference])" />
