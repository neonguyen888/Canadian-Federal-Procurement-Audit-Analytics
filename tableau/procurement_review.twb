    <worksheet name="Review queue">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f2f5" fontsize="13" fontname="Tableau Semibold">Highest scores first
</run>
            <run fontcolor="#a3a3b0" fontsize="9">Vendor names are hidden in this public version. Click a row to see why it is flagged.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Awards" name="awards" />
          </datasources>
          <datasource-dependencies datasource="awards">
            <column caption="Department" datatype="string" name="[department]" role="dimension" type="nominal" />
            <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
            <column caption="Is flagged" datatype="boolean" name="[c_is_flagged]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[is_flagged] = 1" />
            </column>
            <column caption="#" datatype="integer" name="[risk_rank]" role="dimension" type="ordinal" />
            <column caption="Vendor" datatype="string" name="[vendor_code]" role="dimension" type="nominal" />
            <column caption="Tests" datatype="string" name="[c_tests]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IIF([t1_splitting] = 1, &quot;T1   &quot;, &quot;&quot;) + IIF([t2_near_limit] = 1, &quot;T2   &quot;, &quot;&quot;) + IIF([t3_amendment_growth] = 1, &quot;T3   &quot;, &quot;&quot;) + IIF([t4_duplicate] = 1, &quot;T4   &quot;, &quot;&quot;) + IIF([t5_concentration] = 1, &quot;T5   &quot;, &quot;&quot;)" />
            </column>
            <column caption="Award reference" datatype="string" name="[award_reference]" role="dimension" type="nominal" />
            <column caption="At award" datatype="real" default-format="*$#,##0.0&quot;K&quot;" name="[c_at_k]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([value_at_award]) / 1000" />
            </column>
            <column caption="Now" datatype="real" default-format="*$#,##0.0&quot;K&quot;" name="[c_now_k]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([value_now]) / 1000" />
            </column>
            <column caption="Change" datatype="real" default-format="*+0%;-0%" name="[c_change]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([value_now]) / SUM([value_at_award]) - 1" />
            </column>
            <column caption="Score" datatype="real" default-format="*0.0" name="[risk_score]" role="measure" type="quantitative" />
            <column-instance column="[department]" derivation="None" name="[none:department:nk]" pivot="key" type="nominal" />
            <column-instance column="[commodity]" derivation="None" name="[none:commodity:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_is_flagged]" derivation="None" name="[none:c_is_flagged:nk]" pivot="key" type="nominal" />
            <column-instance column="[risk_rank]" derivation="None" name="[none:risk_rank:ok]" pivot="key" type="ordinal" />
            <column-instance column="[vendor_code]" derivation="None" name="[none:vendor_code:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_tests]" derivation="None" name="[none:c_tests:nk]" pivot="key" type="nominal" />
            <column-instance column="[award_reference]" derivation="None" name="[none:award_reference:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_at_k]" derivation="User" name="[usr:c_at_k:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_now_k]" derivation="User" name="[usr:c_now_k:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_change]" derivation="User" name="[usr:c_change:qk]" pivot="key" type="quantitative" />
            <column-instance column="[risk_score]" derivation="Sum" name="[sum:risk_score:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[awards].[none:department:nk]" context="true" filter-group="5">
            <groupfilter function="level-members" level="[none:department:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:commodity:nk]" context="true" filter-group="6">
            <groupfilter function="level-members" level="[none:commodity:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:c_is_flagged:nk]" context="true">
            <groupfilter function="member" level="[none:c_is_flagged:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:risk_rank:ok]">
            <groupfilter count="13" end="top" function="end" units="records" user:ui-marker="end" user:ui-top-by-field="true">
              <groupfilter direction="DESC" expression="SUM([risk_score])" function="order" user:ui-marker="order">
                <groupfilter function="level-members" level="[none:risk_rank:ok]" user:ui-enumeration="all" user:ui-marker="enumerate" />
              </groupfilter>
            </groupfilter>
          </filter>
          <filter class="categorical" column="[awards].[:Measure Names]">
            <groupfilter function="union" user:op="manual">
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[usr:c_at_k:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[usr:c_now_k:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[usr:c_change:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[sum:risk_score:qk]&quot;" />
            </groupfilter>
          </filter>
          <sort class="manual" column="[awards].[:Measure Names]" direction="ASC">
            <dictionary>
              <bucket>"[awards].[usr:c_at_k:qk]"</bucket>
              <bucket>"[awards].[usr:c_now_k:qk]"</bucket>
              <bucket>"[awards].[usr:c_change:qk]"</bucket>
              <bucket>"[awards].[sum:risk_score:qk]"</bucket>
            </dictionary>
          </sort>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#a3a3b0" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="header">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="axis">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
            <format attr="tick-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-color" scope="rows" value="#3a3a46" />
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
          <style-rule element="dropline">
            <format attr="line-visibility" value="off" />
          </style-rule>
          <style-rule element="tooltip">
            <format attr="font-family" value="Tableau Book" />
          </style-rule>
          <style-rule element="quick-filter">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="quick-filter-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="parameter-ctrl">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="parameter-ctrl-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" scope="rows" value="true" />
          </style-rule>
          <style-rule element="label">
            <format attr="color" field="[awards].[none:department:nk]" value="#f2f2f5" />
            <format attr="color" field="[awards].[none:c_tests:nk]" value="#ffe600" />
          </style-rule>
          <style-rule element="header">
            <format attr="width" field="[awards].[none:department:nk]" value="290" />
            <format attr="width" field="[awards].[none:risk_rank:ok]" value="34" />
            <format attr="width" field="[awards].[none:vendor_code:nk]" value="62" />
            <format attr="width" field="[awards].[none:commodity:nk]" value="92" />
            <format attr="width" field="[awards].[none:c_tests:nk]" value="130" />
          </style-rule>
