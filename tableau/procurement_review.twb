    <worksheet name="Awards per $1,000">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f2f5" fontsize="13" fontname="Tableau Semibold">Awards jump in the last $1,000 before the limit
</run>
            <run fontcolor="#a3a3b0" fontsize="9">Awards per $1,000 of value. Yellow: the last $5,000 up to the limit. White line: the trend from the values below.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Value bins" name="bins" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="bins">
            <column caption="Chosen commodity" datatype="boolean" name="[c_param]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[commodity_type] = [Parameters].[p_commodity]" />
            </column>
            <column caption="Near the limit" datatype="boolean" name="[c_in_range]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[bin_start] &gt;= IIF([Parameters].[p_commodity] = &quot;G&quot;, 5000, 20000) AND [bin_start] &lt; IIF([Parameters].[p_commodity] = &quot;G&quot;, 45000, 60000)" />
            </column>
            <column caption="Value" datatype="integer" default-format="*$#,##0" name="[bin_start]" role="dimension" type="quantitative" />
            <column caption="Awards" datatype="integer" default-format="n#,##0" name="[total]" role="measure" type="quantitative" />
            <column caption="Trend" datatype="real" default-format="n#,##0" name="[trend]" role="measure" type="quantitative" />
            <column caption="Range" datatype="string" name="[bin_label]" role="dimension" type="nominal" />
            <column caption="Last $5,000 up to the limit" datatype="real" default-format="n#,##0" name="[c_win]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IIF([in_window], [total], NULL))" />
            </column>
            <column caption="Other values" datatype="real" default-format="n#,##0" name="[c_out]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IIF([in_window], NULL, [total]))" />
            </column>
            <column-instance column="[c_param]" derivation="None" name="[none:c_param:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_in_range]" derivation="None" name="[none:c_in_range:nk]" pivot="key" type="nominal" />
            <column-instance column="[bin_start]" derivation="None" name="[none:bin_start:qk]" pivot="key" type="quantitative" />
            <column-instance column="[total]" derivation="Sum" name="[sum:total:qk]" pivot="key" type="quantitative" />
            <column-instance column="[trend]" derivation="Sum" name="[sum:trend:qk]" pivot="key" type="quantitative" />
            <column-instance column="[bin_label]" derivation="Attribute" name="[attr:bin_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_win]" derivation="User" name="[usr:c_win:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_out]" derivation="User" name="[usr:c_out:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Commodity" datatype="string" name="[p_commodity]" param-domain-type="list" role="measure" type="nominal" value="&quot;S&quot;" alias="Services">
              <calculation class="tableau" formula="&quot;S&quot;" />
              <aliases>
                <alias key="&quot;C&quot;" value="Construction" />
                <alias key="&quot;G&quot;" value="Goods" />
                <alias key="&quot;S&quot;" value="Services" />
              </aliases>
              <members>
                <member alias="Services" value="&quot;S&quot;" />
                <member alias="Goods" value="&quot;G&quot;" />
                <member alias="Construction" value="&quot;C&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[bins].[none:c_param:nk]">
            <groupfilter function="member" level="[none:c_param:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[bins].[none:c_in_range:nk]">
            <groupfilter function="member" level="[none:c_in_range:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[bins].[:Measure Names]">
            <groupfilter function="union" user:op="manual">
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[bins].[usr:c_win:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[bins].[usr:c_out:qk]&quot;" />
            </groupfilter>
          </filter>
          <sort class="manual" column="[bins].[:Measure Names]" direction="ASC">
            <dictionary>
              <bucket>"[bins].[usr:c_win:qk]"</bucket>
              <bucket>"[bins].[usr:c_out:qk]"</bucket>
            </dictionary>
          </sort>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#a3a3b0" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="header">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="axis">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
            <format attr="tick-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-color" scope="rows" value="#3a3a46" />
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
          <style-rule element="dropline">
            <format attr="line-visibility" value="off" />
          </style-rule>
          <style-rule element="tooltip">
            <format attr="font-family" value="Tableau Book" />
          </style-rule>
          <style-rule element="quick-filter">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="quick-filter-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="parameter-ctrl">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="parameter-ctrl-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="axis">
            <encoding attr="space" class="0" field="[bins].[sum:trend:qk]" field-type="quantitative" fold="true" scope="rows" synchronized="true" type="space" />
            <format attr="display" class="0" field="[bins].[sum:trend:qk]" scope="rows" value="false" />
            <format attr="title" class="0" field="[bins].[Multiple Values]" scope="rows" value="" />
            <format attr="title" class="0" field="[bins].[none:bin_start:qk]" scope="cols" value="" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Automatic" />
            <style>
              <style-rule element="mark" />
            </style>
          </pane>
          <pane id="1" selection-relaxation-option="selection-relaxation-allow" y-axis-name="[bins].[Multiple Values]">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[bins].[:Measure Names]" />
              <tooltip column="[bins].[attr:bin_label:nk]" />
              <tooltip column="[bins].[sum:total:qk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run bold="true" fontsize="9">&lt;[bins].[attr:bin_label:nk]&gt;
</run>
                <run fontsize="9">Awards: &lt;[bins].[sum:total:qk]&gt;
</run>
                <run fontsize="9">Trend: &lt;[bins].[sum:trend:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="size" value="0.8" />
              </style-rule>
            </style>
          </pane>
          <pane id="2" selection-relaxation-option="selection-relaxation-allow" y-axis-name="[bins].[sum:trend:qk]">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <tooltip column="[bins].[attr:bin_label:nk]" />
              <tooltip column="[bins].[sum:total:qk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run bold="true" fontsize="9">&lt;[bins].[attr:bin_label:nk]&gt;
</run>
                <run fontsize="9">Awards: &lt;[bins].[sum:total:qk]&gt;
</run>
                <run fontsize="9">Trend: &lt;[bins].[sum:trend:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#f2f2f5" />
                <format attr="size" value="1.2" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([bins].[Multiple Values] + [bins].[sum:trend:qk])</rows>
        <cols>[bins].[none:bin_start:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Sole-sourced share by value">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f2f5" fontsize="13" fontname="Tableau Semibold">Sole-sourcing peaks just under each limit
</run>
            <run fontcolor="#a3a3b0" fontsize="9">Sole-sourced share per $1,000 of value. Yellow: services ($40K). Grey: goods ($25K).</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Value bins" name="bins" />
          </datasources>
          <datasource-dependencies datasource="bins">
            <column caption="In range" datatype="boolean" name="[c_share_range]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[bin_start] &lt;= 80000" />
            </column>
            <column caption="Value" datatype="integer" default-format="*$#,##0" name="[bin_start]" role="dimension" type="quantitative" />
            <column caption="Services ($40K limit)" datatype="real" default-format="p0%" name="[c_share_s]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IIF([commodity_type] = &quot;S&quot;, [sole_sourced], NULL)) / SUM(IIF([commodity_type] = &quot;S&quot;, [total], NULL))" />
            </column>
            <column caption="Goods ($25K limit)" datatype="real" default-format="p0%" name="[c_share_g]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IIF([commodity_type] = &quot;G&quot;, [sole_sourced], NULL)) / SUM(IIF([commodity_type] = &quot;G&quot;, [total], NULL))" />
            </column>
            <column-instance column="[c_share_range]" derivation="None" name="[none:c_share_range:nk]" pivot="key" type="nominal" />
            <column-instance column="[bin_start]" derivation="None" name="[none:bin_start:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_share_s]" derivation="User" name="[usr:c_share_s:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_share_g]" derivation="User" name="[usr:c_share_g:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[bins].[none:c_share_range:nk]">
            <groupfilter function="member" level="[none:c_share_range:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[bins].[:Measure Names]">
            <groupfilter function="union" user:op="manual">
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[bins].[usr:c_share_s:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[bins].[usr:c_share_g:qk]&quot;" />
            </groupfilter>
          </filter>
          <sort class="manual" column="[bins].[:Measure Names]" direction="ASC">
            <dictionary>
              <bucket>"[bins].[usr:c_share_s:qk]"</bucket>
              <bucket>"[bins].[usr:c_share_g:qk]"</bucket>
            </dictionary>
          </sort>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#a3a3b0" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="header">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="axis">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
            <format attr="tick-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-color" scope="rows" value="#3a3a46" />
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
          <style-rule element="dropline">
            <format attr="line-visibility" value="off" />
          </style-rule>
          <style-rule element="tooltip">
            <format attr="font-family" value="Tableau Book" />
          </style-rule>
          <style-rule element="quick-filter">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="quick-filter-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="parameter-ctrl">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="parameter-ctrl-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="axis">
            <format attr="title" class="0" field="[bins].[Multiple Values]" scope="rows" value="Share sole-sourced" />
            <format attr="text-format" class="0" field="[bins].[Multiple Values]" scope="rows" value="p0%" />
            <format attr="title" class="0" field="[bins].[none:bin_start:qk]" scope="cols" value="" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <color column="[bins].[:Measure Names]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run bold="true" fontsize="9">&lt;[bins].[:Measure Names]&gt;, from &lt;[bins].[none:bin_start:qk]&gt;
</run>
                <run fontsize="9">Sole-sourced: &lt;[bins].[Multiple Values]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="size" value="0.9" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[bins].[Multiple Values]</rows>
        <cols>[bins].[none:bin_start:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Departments against their own range">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f2f5" fontsize="13" fontname="Tableau Semibold">The ten largest excesses, against each department's own range
</run>
            <run fontcolor="#a3a3b0" fontsize="9">Dot: excess against the trend. Grey bar: same test at $60K to $90K. Yellow: 95% interval clears it.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Departments" name="dept" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="dept">
            <column caption="Chosen commodity" datatype="boolean" name="[c_param]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[commodity_type] = [Parameters].[p_commodity]" />
            </column>
            <column caption="Department" datatype="string" name="[department]" role="dimension" type="nominal" />
            <column caption="Own range" datatype="real" default-format="*0.00&quot;x&quot;" name="[placebo_lo]" role="measure" type="quantitative" />
            <column caption="Range width" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_width]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([placebo_hi]) - SUM([placebo_lo])" />
            </column>
            <column caption="Excess" datatype="real" default-format="*0.00&quot;x&quot;" name="[ratio]" role="measure" type="quantitative" />
            <column caption="Interval low" datatype="real" default-format="*0.00&quot;x&quot;" name="[ci_lo]" role="measure" type="quantitative" />
            <column caption="Interval high" datatype="real" default-format="*0.00&quot;x&quot;" name="[ci_hi]" role="measure" type="quantitative" />
            <column caption="Own range high" datatype="real" default-format="*0.00&quot;x&quot;" name="[placebo_hi]" role="measure" type="quantitative" />
            <column caption="Clear of its own range" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_r_clear]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IIF([ci_lo] &gt; [placebo_hi], [ratio], NULL))" />
            </column>
            <column caption="Inside or near it" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_r_not]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IIF([ci_lo] &gt; [placebo_hi], NULL, [ratio]))" />
            </column>
            <column-instance column="[c_param]" derivation="None" name="[none:c_param:nk]" pivot="key" type="nominal" />
            <column-instance column="[department]" derivation="None" name="[none:department:nk]" pivot="key" type="nominal" />
            <column-instance column="[placebo_lo]" derivation="Sum" name="[sum:placebo_lo:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_width]" derivation="User" name="[usr:c_width:qk]" pivot="key" type="quantitative" />
            <column-instance column="[ratio]" derivation="Sum" name="[sum:ratio:qk]" pivot="key" type="quantitative" />
            <column-instance column="[ci_lo]" derivation="Sum" name="[sum:ci_lo:qk]" pivot="key" type="quantitative" />
            <column-instance column="[ci_hi]" derivation="Sum" name="[sum:ci_hi:qk]" pivot="key" type="quantitative" />
            <column-instance column="[placebo_hi]" derivation="Sum" name="[sum:placebo_hi:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_r_clear]" derivation="User" name="[usr:c_r_clear:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_r_not]" derivation="User" name="[usr:c_r_not:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Commodity" datatype="string" name="[p_commodity]" param-domain-type="list" role="measure" type="nominal" value="&quot;S&quot;" alias="Services">
              <calculation class="tableau" formula="&quot;S&quot;" />
              <aliases>
                <alias key="&quot;C&quot;" value="Construction" />
                <alias key="&quot;G&quot;" value="Goods" />
                <alias key="&quot;S&quot;" value="Services" />
              </aliases>
              <members>
                <member alias="Services" value="&quot;S&quot;" />
                <member alias="Goods" value="&quot;G&quot;" />
                <member alias="Construction" value="&quot;C&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[dept].[none:c_param:nk]" context="true">
            <groupfilter function="member" level="[none:c_param:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[dept].[none:department:nk]">
            <groupfilter count="10" end="top" function="end" units="records" user:ui-marker="end" user:ui-top-by-field="true">
              <groupfilter direction="DESC" expression="SUM([ratio])" function="order" user:ui-marker="order">
                <groupfilter function="level-members" level="[none:department:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
              </groupfilter>
            </groupfilter>
          </filter>
          <filter class="categorical" column="[dept].[:Measure Names]">
            <groupfilter function="union" user:op="manual">
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[dept].[usr:c_r_clear:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[dept].[usr:c_r_not:qk]&quot;" />
            </groupfilter>
          </filter>
          <sort class="computed" column="[dept].[none:department:nk]" direction="DESC" using="[dept].[sum:ratio:qk]" />
          <sort class="manual" column="[dept].[:Measure Names]" direction="ASC">
            <dictionary>
              <bucket>"[dept].[usr:c_r_clear:qk]"</bucket>
              <bucket>"[dept].[usr:c_r_not:qk]"</bucket>
            </dictionary>
          </sort>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#a3a3b0" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="header">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="axis">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
            <format attr="tick-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-color" scope="rows" value="#3a3a46" />
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
          <style-rule element="dropline">
            <format attr="line-visibility" value="off" />
          </style-rule>
          <style-rule element="tooltip">
            <format attr="font-family" value="Tableau Book" />
          </style-rule>
          <style-rule element="quick-filter">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="quick-filter-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="parameter-ctrl">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="parameter-ctrl-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="axis">
            <encoding attr="space" class="0" field="[dept].[Multiple Values]" field-type="quantitative" fold="true" scope="cols" synchronized="true" type="space" />
            <format attr="display" class="0" field="[dept].[Multiple Values]" scope="cols" value="false" />
            <format attr="title" class="0" field="[dept].[sum:placebo_lo:qk]" scope="cols" value="Awards just under the limit, as a multiple of the trend" />
          </style-rule>
          <style-rule element="label">
            <format attr="color" field="[dept].[none:department:nk]" value="#f2f2f5" />
          </style-rule>
          <style-rule element="header">
            <format attr="width" field="[dept].[none:department:nk]" value="250" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Automatic" />
            <style>
              <style-rule element="mark" />
            </style>
          </pane>
          <pane id="1" selection-relaxation-option="selection-relaxation-allow" x-axis-name="[dept].[sum:placebo_lo:qk]">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="GanttBar" />
            <encodings>
              <size column="[dept].[usr:c_width:qk]" />
              <lod column="[dept].[sum:ci_lo:qk]" />
              <lod column="[dept].[sum:ci_hi:qk]" />
              <lod column="[dept].[sum:placebo_hi:qk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run bold="true" fontsize="9">&lt;[dept].[none:department:nk]&gt;
</run>
                <run fontsize="9">Excess: &lt;[dept].[sum:ratio:qk]&gt; the trend (95% interval &lt;[dept].[sum:ci_lo:qk]&gt; to &lt;[dept].[sum:ci_hi:qk]&gt;)
</run>
                <run fontsize="9">Its own range at $60K to $90K: &lt;[dept].[sum:placebo_lo:qk]&gt; to &lt;[dept].[sum:placebo_hi:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#3a3a46" />
                <format attr="size" value="0.6" />
              </style-rule>
            </style>
          </pane>
          <pane id="2" selection-relaxation-option="selection-relaxation-allow" x-axis-name="[dept].[Multiple Values]">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Circle" />
            <encodings>
              <color column="[dept].[:Measure Names]" />
              <lod column="[dept].[sum:ci_lo:qk]" />
              <lod column="[dept].[sum:ci_hi:qk]" />
              <lod column="[dept].[sum:placebo_hi:qk]" />
              <lod column="[dept].[sum:placebo_lo:qk]" />
              <lod column="[dept].[sum:ratio:qk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run bold="true" fontsize="9">&lt;[dept].[none:department:nk]&gt;
</run>
                <run fontsize="9">Excess: &lt;[dept].[sum:ratio:qk]&gt; the trend (95% interval &lt;[dept].[sum:ci_lo:qk]&gt; to &lt;[dept].[sum:ci_hi:qk]&gt;)
</run>
                <run fontsize="9">Its own range at $60K to $90K: &lt;[dept].[sum:placebo_lo:qk]&gt; to &lt;[dept].[sum:placebo_hi:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="size" value="0.9" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[dept].[none:department:nk]</rows>
        <cols>([dept].[sum:placebo_lo:qk] + [dept].[Multiple Values])</cols>
      </table>
    </worksheet>
    <worksheet name="Card: queue size">
      <table>
        <view>
          <datasources>
            <datasource caption="Awards" name="awards" />
          </datasources>
          <datasource-dependencies datasource="awards">
            <column caption="Department" datatype="string" name="[department]" role="dimension" type="nominal" />
            <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
            <column caption="Flagged" datatype="integer" default-format="n#,##0" name="[is_flagged]" role="measure" type="quantitative" />
            <column caption="Flag rate" datatype="real" default-format="p0.0%" name="[c_flag_rate]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_flagged]) / COUNT([award_reference])" />
            </column>
            <column-instance column="[department]" derivation="None" name="[none:department:nk]" pivot="key" type="nominal" />
            <column-instance column="[commodity]" derivation="None" name="[none:commodity:nk]" pivot="key" type="nominal" />
            <column-instance column="[is_flagged]" derivation="Sum" name="[sum:is_flagged:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_flag_rate]" derivation="User" name="[usr:c_flag_rate:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[awards].[none:department:nk]" filter-group="5">
            <groupfilter function="level-members" level="[none:department:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:commodity:nk]" filter-group="6">
            <groupfilter function="level-members" level="[none:commodity:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
