            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="axis">
            <format attr="title" class="0" field="[awards].[usr:c_sole_share:qk]" scope="rows" value="" />
          </style-rule>
          <style-rule element="label">
            <format attr="color" field="[awards].[none:c_year_short:nk]" value="#a3a3b0" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <text column="[awards].[usr:c_sole_share:qk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run bold="true" fontsize="9">&lt;[awards].[none:c_year_short:nk]&gt;
</run>
                <run fontsize="9">Sole-sourced: &lt;[awards].[usr:c_sole_share:qk]&gt;</run>
              </formatted-text>
