</run>
                <run bold="true" fontcolor="#f2f2f5" fontsize="24" fontname="Tableau Semibold">&lt;[headline].[sum:checks_matching:qk]&gt; of &lt;[headline].[sum:checks_total:qk]&gt;
</run>
                <run fontcolor="#a3a3b0" fontsize="9">checks where SQL and pandas agree</run>
              </formatted-text>
            </customized-label>
