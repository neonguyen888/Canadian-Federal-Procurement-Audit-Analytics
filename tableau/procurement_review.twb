    <worksheet name="Card: amended past limit">
      <table>
        <view>
          <datasources>
            <datasource caption="Headline" name="headline" />
          </datasources>
          <datasource-dependencies datasource="headline">
            <column caption="Amended past the limit" datatype="integer" default-format="n#,##0" name="[amended_past_limit]" role="measure" type="quantitative" />
            <column caption="At award ($M)" datatype="real" default-format="*$#,##0.0&quot;M&quot;" name="[c_apl_at]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([amended_past_limit_value_at_award]) / 1000000" />
            </column>
            <column caption="Now ($M)" datatype="real" default-format="*$#,##0.0&quot;M&quot;" name="[c_apl_now]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([amended_past_limit_value_now]) / 1000000" />
            </column>
            <column-instance column="[amended_past_limit]" derivation="Sum" name="[sum:amended_past_limit:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_apl_at]" derivation="User" name="[usr:c_apl_at:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_apl_now]" derivation="User" name="[usr:c_apl_now:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
