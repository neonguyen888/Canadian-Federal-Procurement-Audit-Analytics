            <groupfilter function="level-members" level="[none:department:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:commodity:nk]" filter-group="4">
            <groupfilter function="level-members" level="[none:commodity:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[:Measure Names]">
            <groupfilter function="union" user:op="manual">
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[sum:t1_splitting:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[sum:t2_near_limit:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[sum:t3_amendment_growth:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[sum:t4_duplicate:qk]&quot;" />
              <groupfilter function="member" level="[:Measure Names]" member="&quot;[awards].[sum:t5_concentration:qk]&quot;" />
            </groupfilter>
          </filter>
          <sort class="manual" column="[awards].[:Measure Names]" direction="ASC">
            <dictionary>
              <bucket>"[awards].[sum:t1_splitting:qk]"</bucket>
              <bucket>"[awards].[sum:t2_near_limit:qk]"</bucket>
              <bucket>"[awards].[sum:t3_amendment_growth:qk]"</bucket>
              <bucket>"[awards].[sum:t4_duplicate:qk]"</bucket>
              <bucket>"[awards].[sum:t5_concentration:qk]"</bucket>
            </dictionary>
          </sort>
          <aggregation value="true" />
        </view>
        <style>
