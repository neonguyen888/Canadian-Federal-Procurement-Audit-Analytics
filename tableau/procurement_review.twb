            </view>
            <mark class="Bar" />
            <encodings>
              <text column="[awards].[usr:c_flag_rate:qk]" />
              <text column="[awards].[sum:is_flagged:qk]" />
              <lod column="[awards].[avg:c_overall_rate:qk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run bold="true" fontsize="9">&lt;[awards].[none:department:nk]&gt;
</run>
                <run fontsize="9">Flag rate: &lt;[awards].[usr:c_flag_rate:qk]&gt;
</run>
                <run fontsize="9">Awards flagged: &lt;[awards].[sum:is_flagged:qk]&gt;
</run>
                <run fontsize="9">All departments: &lt;[awards].[avg:c_overall_rate:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontcolor="#a3a3b0" fontsize="9">&lt;[awards].[usr:c_flag_rate:qk]&gt;  (&lt;[awards].[sum:is_flagged:qk]&gt;)</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
                <format attr="size" value="0.5" />
                <format attr="mark-color" value="#2a2a33" />
              </style-rule>
            </style>
          </pane>
          <pane id="2" selection-relaxation-option="selection-relaxation-allow" x-axis-name="[awards].[Multiple Values]">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[awards].[:Measure Names]" />
              <lod column="[awards].[sum:is_flagged:qk]" />
              <lod column="[awards].[avg:c_overall_rate:qk]" />
              <lod column="[awards].[usr:c_flag_rate:qk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run bold="true" fontsize="9">&lt;[awards].[none:department:nk]&gt;
</run>
                <run fontsize="9">Flag rate: &lt;[awards].[usr:c_flag_rate:qk]&gt;
</run>
                <run fontsize="9">Awards flagged: &lt;[awards].[sum:is_flagged:qk]&gt;
</run>
                <run fontsize="9">All departments: &lt;[awards].[avg:c_overall_rate:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="size" value="0.5" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[awards].[none:department:nk]</rows>
        <cols>([awards].[usr:c_flag_rate:qk] + [awards].[Multiple Values])</cols>
      </table>
    </worksheet>
    <worksheet name="Sole-sourced share by year">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f2f5" fontsize="13" fontname="Tableau Semibold">Sole-sourcing peaked in 2024-25
</run>
            <run fontcolor="#a3a3b0" fontsize="9">Share of awards made without competition.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Awards" name="awards" />
          </datasources>
          <datasource-dependencies datasource="awards">
            <column caption="Fiscal year" datatype="string" name="[fiscal_year]" role="dimension" type="nominal" />
            <column caption="Department" datatype="string" name="[department]" role="dimension" type="nominal" />
            <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
            <column caption="Year is closed" datatype="boolean" name="[c_closed_year]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[fiscal_year] &lt;&gt; &quot;2026-2027&quot;" />
            </column>
            <column caption="Year" datatype="string" name="[c_year_short]" role="dimension" type="nominal">
              <calculation class="tableau" formula="MID([fiscal_year], 3, 2) + &quot;-&quot; + MID([fiscal_year], 8, 2)" />
            </column>
            <column caption="Sole-sourced share" datatype="real" default-format="p0.0%" name="[c_sole_share]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IIF([competition] = &quot;Sole-sourced&quot;, 1, 0)) / COUNT([award_reference])" />
            </column>
            <column-instance column="[fiscal_year]" derivation="None" name="[none:fiscal_year:nk]" pivot="key" type="nominal" />
            <column-instance column="[department]" derivation="None" name="[none:department:nk]" pivot="key" type="nominal" />
            <column-instance column="[commodity]" derivation="None" name="[none:commodity:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_closed_year]" derivation="None" name="[none:c_closed_year:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_year_short]" derivation="None" name="[none:c_year_short:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_sole_share]" derivation="User" name="[usr:c_sole_share:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[awards].[none:fiscal_year:nk]" filter-group="2">
            <groupfilter function="level-members" level="[none:fiscal_year:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:department:nk]" filter-group="3">
            <groupfilter function="level-members" level="[none:department:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:commodity:nk]" filter-group="4">
            <groupfilter function="level-members" level="[none:commodity:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:c_closed_year:nk]">
            <groupfilter function="member" level="[none:c_closed_year:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#a3a3b0" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="header">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="axis">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
            <format attr="tick-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="label">
