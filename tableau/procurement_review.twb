            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-color" scope="rows" value="#3a3a46" />
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
          <style-rule element="dropline">
            <format attr="line-visibility" value="off" />
          </style-rule>
          <style-rule element="tooltip">
            <format attr="font-family" value="Tableau Book" />
          </style-rule>
          <style-rule element="quick-filter">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="quick-filter-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="parameter-ctrl">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="parameter-ctrl-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="label">
            <format attr="display" field="[awards].[none:fiscal_quarter:nk]" value="false" />
            <format attr="color" field="[awards].[none:fiscal_year:nk]" value="#a3a3b0" />
          </style-rule>
          <style-rule element="axis">
            <format attr="title" class="0" field="[awards].[Multiple Values]" scope="rows" value="$ billions" />
            <format attr="text-format" class="0" field="[awards].[Multiple Values]" scope="rows" value="*$#,##0&quot;B&quot;" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
