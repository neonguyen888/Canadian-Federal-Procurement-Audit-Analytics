<?xml version='1.0' encoding='utf-8' ?>

<workbook xmlns:user="http://www.tableausoftware.com/xml/user" source-build="2026.3.0" source-platform="mac" version="18.1" locale="en_US">
  <preferences />
  <style>
    <style-rule element="quick-filter">
      <format attr="color" value="#f2f2f5" />
      <format attr="background-color" value="#2a2a33" />
      <format attr="font-family" value="Tableau Book" />
    </style-rule>
    <style-rule element="quick-filter-title">
      <format attr="color" value="#a3a3b0" />
      <format attr="font-family" value="Tableau Book" />
    </style-rule>
    <style-rule element="parameter-ctrl">
      <format attr="color" value="#f2f2f5" />
      <format attr="background-color" value="#2a2a33" />
      <format attr="font-family" value="Tableau Book" />
    </style-rule>
    <style-rule element="parameter-ctrl-title">
      <format attr="color" value="#a3a3b0" />
      <format attr="font-family" value="Tableau Book" />
    </style-rule>
  </style>
  <datasources>
    <datasource hasconnection="false" inline="true" name="Parameters" version="18.1">
      <aliases enabled="yes" />
      <column caption="Commodity" datatype="string" name="[p_commodity]" param-domain-type="list" role="measure" type="nominal" value="&quot;S&quot;" alias="Services">
        <calculation class="tableau" formula="&quot;S&quot;" />
        <aliases>
          <alias key="&quot;C&quot;" value="Construction" />
          <alias key="&quot;G&quot;" value="Goods" />
          <alias key="&quot;S&quot;" value="Services" />
        </aliases>
        <members>
          <member alias="Services" value="&quot;S&quot;" />
          <member alias="Goods" value="&quot;G&quot;" />
          <member alias="Construction" value="&quot;C&quot;" />
        </members>
      </column>
    </datasource>
    <datasource caption="Awards" inline="true" name="awards" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="Awards" name="textscan.awards">
            <connection class="textscan" directory="../data/tableau" filename="awards.csv" password="" server="" character-set="UTF-8" header="yes" separator="," text-qualifier="&quot;" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.awards" name="awards.csv" table="[awards#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="string" name="owner_org" ordinal="0" />
            <column datatype="string" name="department" ordinal="1" />
            <column datatype="string" name="award_reference" ordinal="2" />
            <column datatype="string" name="vendor_code" ordinal="3" />
            <column datatype="date" name="award_date" ordinal="4" />
            <column datatype="string" name="fiscal_year" ordinal="5" />
            <column datatype="string" name="fiscal_quarter" ordinal="6" />
            <column datatype="string" name="commodity" ordinal="7" />
            <column datatype="string" name="competition" ordinal="8" />
            <column datatype="real" name="value_at_award" ordinal="9" />
            <column datatype="real" name="value_now" ordinal="10" />
            <column datatype="integer" name="n_amendments" ordinal="11" />
            <column datatype="real" name="s6b_limit" ordinal="12" />
            <column datatype="boolean" name="is_within_limit" ordinal="13" />
            <column datatype="integer" name="t1_splitting" ordinal="14" />
            <column datatype="integer" name="t2_near_limit" ordinal="15" />
            <column datatype="integer" name="t3_amendment_growth" ordinal="16" />
            <column datatype="integer" name="t4_duplicate" ordinal="17" />
            <column datatype="integer" name="t5_concentration" ordinal="18" />
            <column datatype="integer" name="n_flags" ordinal="19" />
            <column datatype="integer" name="is_flagged" ordinal="20" />
            <column datatype="real" name="risk_score" ordinal="21" />
            <column datatype="integer" name="risk_rank" ordinal="22" />
            <column datatype="string" name="flag_details" ordinal="23" />
          </columns>
        </relation>
      </connection>
      <column caption="Department code" datatype="string" name="[owner_org]" role="dimension" type="nominal" />
      <column caption="Department" datatype="string" name="[department]" role="dimension" type="nominal" />
      <column caption="Award reference" datatype="string" name="[award_reference]" role="dimension" type="nominal" />
      <column caption="Vendor" datatype="string" name="[vendor_code]" role="dimension" type="nominal" />
      <column caption="Award date" datatype="date" name="[award_date]" role="dimension" type="ordinal" />
      <column caption="Fiscal year" datatype="string" name="[fiscal_year]" role="dimension" type="nominal" />
      <column caption="Fiscal quarter" datatype="string" name="[fiscal_quarter]" role="dimension" type="nominal" />
      <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
      <column caption="Competition" datatype="string" name="[competition]" role="dimension" type="nominal" />
      <column caption="At award" datatype="real" default-format="*$#,##0" name="[value_at_award]" role="measure" type="quantitative" />
      <column caption="Now" datatype="real" default-format="*$#,##0" name="[value_now]" role="measure" type="quantitative" />
      <column caption="Amendments" datatype="integer" name="[n_amendments]" role="measure" type="quantitative" />
      <column caption="Limit" datatype="real" default-format="*$#,##0" name="[s6b_limit]" role="measure" type="quantitative" />
      <column caption="Within limit" datatype="boolean" name="[is_within_limit]" role="dimension" type="nominal" />
      <column caption="Contract splitting" datatype="integer" default-format="n#,##0" name="[t1_splitting]" role="measure" type="quantitative" />
      <column caption="Sole-source near limit" datatype="integer" default-format="n#,##0" name="[t2_near_limit]" role="measure" type="quantitative" />
      <column caption="Amendment growth" datatype="integer" default-format="n#,##0" name="[t3_amendment_growth]" role="measure" type="quantitative" />
      <column caption="Possible duplicate" datatype="integer" default-format="n#,##0" name="[t4_duplicate]" role="measure" type="quantitative" />
      <column caption="Vendor concentration" datatype="integer" default-format="n#,##0" name="[t5_concentration]" role="measure" type="quantitative" />
      <column caption="Flags" datatype="integer" name="[n_flags]" role="measure" type="quantitative" />
      <column caption="Flagged" datatype="integer" default-format="n#,##0" name="[is_flagged]" role="measure" type="quantitative" />
      <column caption="Score" datatype="real" default-format="*0.0" name="[risk_score]" role="measure" type="quantitative" />
      <column caption="#" datatype="integer" name="[risk_rank]" role="dimension" type="ordinal" />
      <column caption="Why it is flagged" datatype="string" name="[flag_details]" role="dimension" type="nominal" />
      <column caption="Awards" datatype="real" default-format="n#,##0" name="[c_awards]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNT([award_reference])" />
      </column>
      <column caption="Departments" datatype="string" name="[c_dept_label]" role="measure" type="nominal">
        <calculation class="tableau" formula="IIF(COUNTD([department]) = 1, &quot;1 department&quot;, STR(COUNTD([department])) + &quot; departments&quot;)" />
      </column>
      <column caption="Flag rate" datatype="real" default-format="p0.0%" name="[c_flag_rate]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([is_flagged]) / COUNT([award_reference])" />
      </column>
      <column caption="Sole-sourced awards" datatype="real" default-format="n#,##0" name="[c_sole_n]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([competition] = &quot;Sole-sourced&quot;, 1, 0))" />
      </column>
      <column caption="Sole-sourced share" datatype="real" default-format="p0.0%" name="[c_sole_share]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([competition] = &quot;Sole-sourced&quot;, 1, 0)) / COUNT([award_reference])" />
      </column>
      <column caption="Value at award ($B)" datatype="real" default-format="*$#,##0.0&quot;B&quot;" name="[c_value_b]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([value_at_award]) / 1000000000" />
      </column>
      <column caption="Value now ($B)" datatype="real" default-format="*$#,##0.0&quot;B&quot;" name="[c_value_now_b]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([value_now]) / 1000000000" />
      </column>
      <column caption="Value flagged ($B)" datatype="real" default-format="*$#,##0.0&quot;B&quot;" name="[c_flagged_value_b]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([is_flagged] = 1, [value_at_award], 0)) / 1000000000" />
      </column>
      <column caption="Two or more flags" datatype="real" default-format="n#,##0" name="[c_two_plus]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([n_flags] &gt;= 2, 1, 0))" />
      </column>
      <column caption="Quarter group" datatype="string" name="[c_is_q4]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IIF([fiscal_quarter] = &quot;Q4&quot;, &quot;Q4&quot;, &quot;Other quarters&quot;)" />
      </column>
      <column caption="First row" datatype="boolean" name="[c_first]" role="dimension" type="nominal">
        <calculation class="tableau" formula="FIRST() = 0" />
      </column>
      <column caption="Year is closed" datatype="boolean" name="[c_closed_year]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[fiscal_year] &lt;&gt; &quot;2026-2027&quot;" />
      </column>
      <column caption="Overall flag rate" datatype="real" default-format="p0.0%" name="[c_overall_rate]" role="measure" type="quantitative">
        <calculation class="tableau" formula="{FIXED : SUM([is_flagged])} / {FIXED : COUNT([award_reference])}" />
      </column>
      <column caption="Against the average" datatype="string" name="[c_above_avg]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IIF([c_flag_rate] &gt; AVG([c_overall_rate]), &quot;Above average&quot;, &quot;At or below average&quot;)" />
      </column>
      <column caption="Year" datatype="string" name="[c_year_short]" role="dimension" type="nominal">
        <calculation class="tableau" formula="MID([fiscal_year], 3, 2) + &quot;-&quot; + MID([fiscal_year], 8, 2)" />
      </column>
      <column caption="Change" datatype="real" default-format="*+0%;-0%" name="[c_change]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([value_now]) / SUM([value_at_award]) - 1" />
      </column>
      <column caption="Q4 (January to March)" datatype="real" default-format="*$#,##0.0&quot;B&quot;" name="[c_val_q4]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([fiscal_quarter] = &quot;Q4&quot;, [value_at_award], NULL)) / 1000000000" />
      </column>
      <column caption="Other quarters" datatype="real" default-format="*$#,##0.0&quot;B&quot;" name="[c_val_other]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([fiscal_quarter] &lt;&gt; &quot;Q4&quot;, [value_at_award], NULL)) / 1000000000" />
      </column>
      <column caption="Above the average" datatype="real" default-format="p0.0%" name="[c_rate_above]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IIF([c_flag_rate] &gt; AVG([c_overall_rate]), [c_flag_rate], NULL)" />
      </column>
      <column caption="At or below the average" datatype="real" default-format="p0.0%" name="[c_rate_below]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IIF([c_flag_rate] &lt;= AVG([c_overall_rate]), [c_flag_rate], NULL)" />
      </column>
      <column caption="At award" datatype="real" default-format="*$#,##0.0&quot;K&quot;" name="[c_at_k]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([value_at_award]) / 1000" />
      </column>
      <column caption="Now" datatype="real" default-format="*$#,##0.0&quot;K&quot;" name="[c_now_k]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([value_now]) / 1000" />
      </column>
      <column caption="Tests" datatype="string" name="[c_tests]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IIF([t1_splitting] = 1, &quot;T1   &quot;, &quot;&quot;) + IIF([t2_near_limit] = 1, &quot;T2   &quot;, &quot;&quot;) + IIF([t3_amendment_growth] = 1, &quot;T3   &quot;, &quot;&quot;) + IIF([t4_duplicate] = 1, &quot;T4   &quot;, &quot;&quot;) + IIF([t5_concentration] = 1, &quot;T5   &quot;, &quot;&quot;)" />
      </column>
      <column caption="Is flagged" datatype="boolean" name="[c_is_flagged]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[is_flagged] = 1" />
      </column>
      <column caption="Why it is flagged" datatype="string" name="[c_details]" role="dimension" type="nominal">
        <calculation class="tableau" formula="REPLACE([flag_details], &quot; | &quot;, CHAR(10) + CHAR(10))" />
      </column>
      <style>
        <style-rule element="mark">
          <encoding attr="color" field="[none:c_is_q4:nk]" type="palette">
            <map to="#ffe600">
              <bucket>"Q4"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"Other quarters"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[c_is_q4]" type="palette">
            <map to="#ffe600">
              <bucket>"Q4"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"Other quarters"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[usr:c_above_avg:nk]" type="palette">
            <map to="#ffe600">
              <bucket>"Above average"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"At or below average"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[c_above_avg]" type="palette">
            <map to="#ffe600">
              <bucket>"Above average"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"At or below average"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[:Measure Names]" type="palette">
            <map to="#c9c9d2">
              <bucket>"[awards].[sum:t1_splitting:qk]"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"[awards].[sum:t2_near_limit:qk]"</bucket>
            </map>
            <map to="#ffe600">
              <bucket>"[awards].[sum:t3_amendment_growth:qk]"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"[awards].[sum:t4_duplicate:qk]"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"[awards].[sum:t5_concentration:qk]"</bucket>
            </map>
            <map to="#f2f2f5">
              <bucket>"[awards].[usr:c_at_k:qk]"</bucket>
            </map>
            <map to="#f2f2f5">
              <bucket>"[awards].[usr:c_now_k:qk]"</bucket>
            </map>
            <map to="#ffe600">
              <bucket>"[awards].[usr:c_change:qk]"</bucket>
            </map>
            <map to="#f2f2f5">
              <bucket>"[awards].[sum:risk_score:qk]"</bucket>
            </map>
            <map to="#ffe600">
              <bucket>"[awards].[usr:c_val_q4:qk]"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"[awards].[usr:c_val_other:qk]"</bucket>
            </map>
            <map to="#ffe600">
              <bucket>"[awards].[usr:c_rate_above:qk]"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"[awards].[usr:c_rate_below:qk]"</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
    <datasource caption="Value bins" inline="true" name="bins" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="Value bins" name="textscan.bins">
            <connection class="textscan" directory="../data/tableau" filename="value_bins.csv" password="" server="" character-set="UTF-8" header="yes" separator="," text-qualifier="&quot;" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.bins" name="value_bins.csv" table="[value_bins#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="string" name="commodity_type" ordinal="0" />
            <column datatype="integer" name="bin_start" ordinal="1" />
            <column datatype="integer" name="sole_sourced" ordinal="2" />
            <column datatype="integer" name="competed" ordinal="3" />
            <column datatype="integer" name="unknown" ordinal="4" />
            <column datatype="integer" name="total" ordinal="5" />
            <column datatype="string" name="bin_label" ordinal="6" />
            <column datatype="real" name="trend" ordinal="7" />
            <column datatype="boolean" name="in_window" ordinal="8" />
          </columns>
        </relation>
      </connection>
      <column caption="Commodity type" datatype="string" name="[commodity_type]" role="dimension" type="nominal" />
      <column caption="Value" datatype="integer" default-format="*$#,##0" name="[bin_start]" role="dimension" type="quantitative" />
      <column caption="Sole-sourced" datatype="integer" name="[sole_sourced]" role="measure" type="quantitative" />
      <column caption="Competed" datatype="integer" name="[competed]" role="measure" type="quantitative" />
      <column caption="Unknown" datatype="integer" name="[unknown]" role="measure" type="quantitative" />
      <column caption="Awards" datatype="integer" default-format="n#,##0" name="[total]" role="measure" type="quantitative" />
      <column caption="Range" datatype="string" name="[bin_label]" role="dimension" type="nominal" />
      <column caption="Trend" datatype="real" default-format="n#,##0" name="[trend]" role="measure" type="quantitative" />
      <column caption="Last $5,000" datatype="boolean" name="[in_window]" role="dimension" type="nominal" />
      <column caption="Chosen commodity" datatype="boolean" name="[c_param]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[commodity_type] = [Parameters].[p_commodity]" />
      </column>
      <column caption="Limit" datatype="real" default-format="*$#,##0" name="[c_limit]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IIF([Parameters].[p_commodity] = &quot;G&quot;, 25000, 40000)" />
      </column>
      <column caption="Near the limit" datatype="boolean" name="[c_in_range]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[bin_start] &gt;= IIF([Parameters].[p_commodity] = &quot;G&quot;, 5000, 20000) AND [bin_start] &lt; IIF([Parameters].[p_commodity] = &quot;G&quot;, 45000, 60000)" />
      </column>
      <column caption="Bar" datatype="string" name="[c_bar]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IIF([in_window], &quot;Last $5,000 up to the limit&quot;, &quot;Other values&quot;)" />
      </column>
      <column caption="Sole-sourced share" datatype="real" default-format="p0%" name="[c_share]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([sole_sourced]) / SUM([total])" />
      </column>
      <column caption="Commodity" datatype="string" name="[c_commodity_name]" role="dimension" type="nominal">
        <calculation class="tableau" formula="CASE [commodity_type] WHEN &quot;S&quot; THEN &quot;Services ($40K)&quot; WHEN &quot;G&quot; THEN &quot;Goods ($25K)&quot; ELSE &quot;Construction&quot; END" />
      </column>
      <column caption="In range" datatype="boolean" name="[c_share_range]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[bin_start] &lt;= 80000" />
      </column>
      <column caption="Last $5,000 up to the limit" datatype="real" default-format="n#,##0" name="[c_win]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([in_window], [total], NULL))" />
      </column>
      <column caption="Other values" datatype="real" default-format="n#,##0" name="[c_out]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([in_window], NULL, [total]))" />
      </column>
      <column caption="Services ($40K limit)" datatype="real" default-format="p0%" name="[c_share_s]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([commodity_type] = &quot;S&quot;, [sole_sourced], NULL)) / SUM(IIF([commodity_type] = &quot;S&quot;, [total], NULL))" />
      </column>
      <column caption="Goods ($25K limit)" datatype="real" default-format="p0%" name="[c_share_g]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([commodity_type] = &quot;G&quot;, [sole_sourced], NULL)) / SUM(IIF([commodity_type] = &quot;G&quot;, [total], NULL))" />
      </column>
      <style>
        <style-rule element="mark">
          <encoding attr="color" field="[:Measure Names]" type="palette">
            <map to="#ffe600">
              <bucket>"[bins].[usr:c_win:qk]"</bucket>
            </map>
            <map to="#5e5e6c">
              <bucket>"[bins].[usr:c_out:qk]"</bucket>
            </map>
            <map to="#ffe600">
              <bucket>"[bins].[usr:c_share_s:qk]"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"[bins].[usr:c_share_g:qk]"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[none:c_bar:nk]" type="palette">
            <map to="#ffe600">
              <bucket>"Last $5,000 up to the limit"</bucket>
            </map>
            <map to="#5e5e6c">
              <bucket>"Other values"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[c_bar]" type="palette">
            <map to="#ffe600">
              <bucket>"Last $5,000 up to the limit"</bucket>
            </map>
            <map to="#5e5e6c">
              <bucket>"Other values"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[none:c_commodity_name:nk]" type="palette">
            <map to="#c9c9d2">
              <bucket>"Services ($40K)"</bucket>
            </map>
            <map to="#5e5e6c">
              <bucket>"Goods ($25K)"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[c_commodity_name]" type="palette">
            <map to="#c9c9d2">
              <bucket>"Services ($40K)"</bucket>
            </map>
            <map to="#5e5e6c">
              <bucket>"Goods ($25K)"</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
    <datasource caption="Bunching summary" inline="true" name="bunch" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="Bunching summary" name="textscan.bunch">
            <connection class="textscan" directory="../data/tableau" filename="bunching_summary.csv" password="" server="" character-set="UTF-8" header="yes" separator="," text-qualifier="&quot;" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.bunch" name="bunching_summary.csv" table="[bunching_summary#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="string" name="commodity_type" ordinal="0" />
            <column datatype="string" name="limit_kind" ordinal="1" />
            <column datatype="integer" name="limit" ordinal="2" />
            <column datatype="string" name="group" ordinal="3" />
            <column datatype="integer" name="observed" ordinal="4" />
            <column datatype="real" name="expected" ordinal="5" />
            <column datatype="real" name="excess" ordinal="6" />
            <column datatype="real" name="ratio" ordinal="7" />
            <column datatype="real" name="ci_lo" ordinal="8" />
            <column datatype="real" name="ci_hi" ordinal="9" />
          </columns>
        </relation>
      </connection>
      <column caption="Commodity type" datatype="string" name="[commodity_type]" role="dimension" type="nominal" />
      <column caption="Kind" datatype="string" name="[limit_kind]" role="dimension" type="nominal" />
      <column caption="Limit" datatype="integer" name="[limit]" role="dimension" type="ordinal" />
      <column caption="Group" datatype="string" name="[group]" role="dimension" type="nominal" />
      <column caption="Observed" datatype="integer" name="[observed]" role="measure" type="quantitative" />
      <column caption="Expected" datatype="real" name="[expected]" role="measure" type="quantitative" />
      <column caption="Excess" datatype="real" name="[excess]" role="measure" type="quantitative" />
      <column caption="Ratio" datatype="real" default-format="*0.00&quot;x&quot;" name="[ratio]" role="measure" type="quantitative" />
      <column caption="Interval low" datatype="real" default-format="*0.00&quot;x&quot;" name="[ci_lo]" role="measure" type="quantitative" />
      <column caption="Interval high" datatype="real" default-format="*0.00&quot;x&quot;" name="[ci_hi]" role="measure" type="quantitative" />
      <column caption="Chosen commodity" datatype="boolean" name="[c_param]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[commodity_type] = [Parameters].[p_commodity]" />
      </column>
      <column caption="Observed" datatype="real" default-format="n#,##0" name="[c_obs]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(IIF([group] = &quot;all&quot;, [observed], NULL))" />
      </column>
      <column caption="Expected" datatype="real" default-format="n#,##0" name="[c_exp]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(IIF([group] = &quot;all&quot;, [expected], NULL))" />
      </column>
      <column caption="All awards" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_ratio]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(IIF([group] = &quot;all&quot;, [ratio], NULL))" />
      </column>
      <column caption="Interval low" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_lo]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(IIF([group] = &quot;all&quot;, [ci_lo], NULL))" />
      </column>
      <column caption="Interval high" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_hi]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(IIF([group] = &quot;all&quot;, [ci_hi], NULL))" />
      </column>
      <column caption="Sole-sourced" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_ratio_nc]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(IIF([group] = &quot;non_competitive&quot;, [ratio], NULL))" />
      </column>
      <column caption="Competed" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_ratio_c]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(IIF([group] = &quot;competitive&quot;, [ratio], NULL))" />
      </column>
      <column caption="Placebo low" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_pl_min]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MIN(IIF([group] = &quot;all&quot;, [ratio], NULL))" />
      </column>
      <column caption="Placebo high" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_pl_max]" role="measure" type="quantitative">
        <calculation class="tableau" formula="MAX(IIF([group] = &quot;all&quot;, [ratio], NULL))" />
      </column>
    </datasource>
    <datasource caption="Departments" inline="true" name="dept" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="Departments" name="textscan.dept">
            <connection class="textscan" directory="../data/tableau" filename="bunching_by_department.csv" password="" server="" character-set="UTF-8" header="yes" separator="," text-qualifier="&quot;" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.dept" name="bunching_by_department.csv" table="[bunching_by_department#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="string" name="department" ordinal="0" />
            <column datatype="string" name="commodity_type" ordinal="1" />
            <column datatype="integer" name="n_in_range" ordinal="2" />
            <column datatype="integer" name="observed" ordinal="3" />
            <column datatype="real" name="expected" ordinal="4" />
            <column datatype="real" name="ratio" ordinal="5" />
            <column datatype="real" name="ci_lo" ordinal="6" />
            <column datatype="real" name="ci_hi" ordinal="7" />
            <column datatype="real" name="placebo_lo" ordinal="8" />
            <column datatype="real" name="placebo_hi" ordinal="9" />
          </columns>
        </relation>
      </connection>
      <column caption="Department" datatype="string" name="[department]" role="dimension" type="nominal" />
      <column caption="Commodity type" datatype="string" name="[commodity_type]" role="dimension" type="nominal" />
      <column caption="Awards in range" datatype="integer" name="[n_in_range]" role="measure" type="quantitative" />
      <column caption="Observed" datatype="integer" name="[observed]" role="measure" type="quantitative" />
      <column caption="Expected" datatype="real" name="[expected]" role="measure" type="quantitative" />
      <column caption="Excess" datatype="real" default-format="*0.00&quot;x&quot;" name="[ratio]" role="measure" type="quantitative" />
      <column caption="Interval low" datatype="real" default-format="*0.00&quot;x&quot;" name="[ci_lo]" role="measure" type="quantitative" />
      <column caption="Interval high" datatype="real" default-format="*0.00&quot;x&quot;" name="[ci_hi]" role="measure" type="quantitative" />
      <column caption="Own range" datatype="real" default-format="*0.00&quot;x&quot;" name="[placebo_lo]" role="measure" type="quantitative" />
      <column caption="Own range high" datatype="real" default-format="*0.00&quot;x&quot;" name="[placebo_hi]" role="measure" type="quantitative" />
      <column caption="Chosen commodity" datatype="boolean" name="[c_param]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[commodity_type] = [Parameters].[p_commodity]" />
      </column>
      <column caption="Range width" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_width]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([placebo_hi]) - SUM([placebo_lo])" />
      </column>
      <column caption="Clear of its own range" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_r_clear]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([ci_lo] &gt; [placebo_hi], [ratio], NULL))" />
      </column>
      <column caption="Inside or near it" datatype="real" default-format="*0.00&quot;x&quot;" name="[c_r_not]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([ci_lo] &gt; [placebo_hi], NULL, [ratio]))" />
      </column>
      <column caption="Against its own range" datatype="string" name="[c_clear]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IIF([ci_lo] &gt; [placebo_hi], &quot;Clear of its own range&quot;, &quot;Inside or near it&quot;)" />
      </column>
      <style>
        <style-rule element="mark">
          <encoding attr="color" field="[:Measure Names]" type="palette">
            <map to="#ffe600">
              <bucket>"[dept].[usr:c_r_clear:qk]"</bucket>
            </map>
            <map to="#c9c9d2">
              <bucket>"[dept].[usr:c_r_not:qk]"</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
    <datasource caption="Headline" inline="true" name="headline" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="Headline" name="textscan.headline">
            <connection class="textscan" directory="../data/tableau" filename="headline.csv" password="" server="" character-set="UTF-8" header="yes" separator="," text-qualifier="&quot;" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.headline" name="headline.csv" table="[headline#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator="," text-qualifier="&quot;">
            <column datatype="string" name="data_as_of" ordinal="0" />
            <column datatype="string" name="analysis_start" ordinal="1" />
            <column datatype="integer" name="checks_matching" ordinal="2" />
            <column datatype="integer" name="checks_total" ordinal="3" />
            <column datatype="integer" name="hard_checks_passed" ordinal="4" />
            <column datatype="integer" name="hard_checks_total" ordinal="5" />
            <column datatype="real" name="placebo_low_services" ordinal="6" />
            <column datatype="real" name="placebo_high_services" ordinal="7" />
            <column datatype="integer" name="amended_past_limit" ordinal="8" />
            <column datatype="real" name="amended_past_limit_value_at_award" ordinal="9" />
            <column datatype="real" name="amended_past_limit_value_now" ordinal="10" />
            <column datatype="integer" name="departments_clear_of_own_placebo" ordinal="11" />
            <column datatype="integer" name="departments_estimated" ordinal="12" />
          </columns>
        </relation>
      </connection>
      <column caption="Data as of" datatype="string" name="[data_as_of]" role="dimension" type="nominal" />
      <column caption="Analysis start" datatype="string" name="[analysis_start]" role="dimension" type="nominal" />
      <column caption="Checks matching" datatype="integer" name="[checks_matching]" role="measure" type="quantitative" />
      <column caption="Checks" datatype="integer" name="[checks_total]" role="measure" type="quantitative" />
      <column caption="Hard checks passed" datatype="integer" name="[hard_checks_passed]" role="measure" type="quantitative" />
      <column caption="Hard checks" datatype="integer" name="[hard_checks_total]" role="measure" type="quantitative" />
      <column caption="Placebo low" datatype="real" name="[placebo_low_services]" role="measure" type="quantitative" />
      <column caption="Placebo high" datatype="real" name="[placebo_high_services]" role="measure" type="quantitative" />
      <column caption="Amended past the limit" datatype="integer" default-format="n#,##0" name="[amended_past_limit]" role="measure" type="quantitative" />
      <column caption="At award" datatype="real" name="[amended_past_limit_value_at_award]" role="measure" type="quantitative" />
      <column caption="Now" datatype="real" name="[amended_past_limit_value_now]" role="measure" type="quantitative" />
      <column caption="Departments clear" datatype="integer" name="[departments_clear_of_own_placebo]" role="measure" type="quantitative" />
      <column caption="Departments estimated" datatype="integer" name="[departments_estimated]" role="measure" type="quantitative" />
      <column caption="At award ($M)" datatype="real" default-format="*$#,##0.0&quot;M&quot;" name="[c_apl_at]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([amended_past_limit_value_at_award]) / 1000000" />
      </column>
      <column caption="Now ($M)" datatype="real" default-format="*$#,##0.0&quot;M&quot;" name="[c_apl_now]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([amended_past_limit_value_now]) / 1000000" />
      </column>
    </datasource>
  </datasources>
  <actions>
    <action caption="Show why the selected award is flagged" name="[Action_why]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="Queue" type="sheet" worksheet="Review queue" />
      <link caption="Why it is flagged" delimiter="," escape="\" expression="tsl:Queue?%5Bawards%5D.%5Brisk_rank%5D~s0=&lt;[risk_rank]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Card: queue size,Card: two or more,Card: queue value,Card: top score,Card: checks,Review queue" />
        <param name="target" value="Queue" />
      </command>
    </action>
    <datasources>
      <datasource caption="Awards" name="awards" />
    </datasources>
    <datasource-dependencies datasource="awards">
      <column caption="#" datatype="integer" name="[risk_rank]" role="dimension" type="ordinal" />
    </datasource-dependencies>
  </actions>
  <worksheets>
    <worksheet name="Card: awards">
      <table>
        <view>
          <datasources>
            <datasource caption="Awards" name="awards" />
          </datasources>
          <datasource-dependencies datasource="awards">
            <column caption="Fiscal year" datatype="string" name="[fiscal_year]" role="dimension" type="nominal" />
            <column caption="Department" datatype="string" name="[department]" role="dimension" type="nominal" />
            <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
            <column caption="Awards" datatype="real" default-format="n#,##0" name="[c_awards]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNT([award_reference])" />
            </column>
            <column caption="Departments" datatype="string" name="[c_dept_label]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(COUNTD([department]) = 1, &quot;1 department&quot;, STR(COUNTD([department])) + &quot; departments&quot;)" />
            </column>
            <column-instance column="[fiscal_year]" derivation="None" name="[none:fiscal_year:nk]" pivot="key" type="nominal" />
            <column-instance column="[department]" derivation="None" name="[none:department:nk]" pivot="key" type="nominal" />
            <column-instance column="[commodity]" derivation="None" name="[none:commodity:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_awards]" derivation="User" name="[usr:c_awards:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_dept_label]" derivation="User" name="[usr:c_dept_label:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[awards].[none:fiscal_year:nk]" filter-group="2">
            <groupfilter function="level-members" level="[none:fiscal_year:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:department:nk]" filter-group="3">
            <groupfilter function="level-members" level="[none:department:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:commodity:nk]" filter-group="4">
            <groupfilter function="level-members" level="[none:commodity:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#a3a3b0" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="header">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="axis">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
            <format attr="tick-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#a3a3b0" />
            <format attr="font-size" value="9" />
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="stroke-size" scope="rows" value="0" />
            <format attr="div-level" scope="rows" value="0" />
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-size" scope="cols" value="0" />
            <format attr="div-level" scope="cols" value="0" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off" />
            <format attr="stroke-color" scope="rows" value="#3a3a46" />
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
          <style-rule element="dropline">
            <format attr="line-visibility" value="off" />
          </style-rule>
          <style-rule element="tooltip">
            <format attr="font-family" value="Tableau Book" />
          </style-rule>
          <style-rule element="quick-filter">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="quick-filter-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="parameter-ctrl">
            <format attr="color" value="#f2f2f5" />
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="parameter-ctrl-title">
            <format attr="color" value="#a3a3b0" />
          </style-rule>
          <style-rule element="cell">
            <format attr="text-align" value="left" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[awards].[usr:c_awards:qk]" />
              <text column="[awards].[usr:c_dept_label:nk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run fontsize="9">Awards</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontcolor="#a3a3b0" fontsize="10">Awards analysed
</run>
                <run bold="true" fontcolor="#f2f2f5" fontsize="24" fontname="Tableau Semibold">&lt;[awards].[usr:c_awards:qk]&gt;
</run>
                <run fontcolor="#a3a3b0" fontsize="9">&lt;[awards].[usr:c_dept_label:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="Card: value">
      <table>
        <view>
          <datasources>
            <datasource caption="Awards" name="awards" />
          </datasources>
          <datasource-dependencies datasource="awards">
            <column caption="Fiscal year" datatype="string" name="[fiscal_year]" role="dimension" type="nominal" />
            <column caption="Department" datatype="string" name="[department]" role="dimension" type="nominal" />
            <column caption="Commodity" datatype="string" name="[commodity]" role="dimension" type="nominal" />
            <column caption="Value at award ($B)" datatype="real" default-format="*$#,##0.0&quot;B&quot;" name="[c_value_b]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([value_at_award]) / 1000000000" />
            </column>
            <column caption="Value now ($B)" datatype="real" default-format="*$#,##0.0&quot;B&quot;" name="[c_value_now_b]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([value_now]) / 1000000000" />
            </column>
            <column-instance column="[fiscal_year]" derivation="None" name="[none:fiscal_year:nk]" pivot="key" type="nominal" />
            <column-instance column="[department]" derivation="None" name="[none:department:nk]" pivot="key" type="nominal" />
            <column-instance column="[commodity]" derivation="None" name="[none:commodity:nk]" pivot="key" type="nominal" />
            <column-instance column="[c_value_b]" derivation="User" name="[usr:c_value_b:qk]" pivot="key" type="quantitative" />
            <column-instance column="[c_value_now_b]" derivation="User" name="[usr:c_value_now_b:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[awards].[none:fiscal_year:nk]" filter-group="2">
            <groupfilter function="level-members" level="[none:fiscal_year:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:department:nk]" filter-group="3">
            <groupfilter function="level-members" level="[none:department:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[awards].[none:commodity:nk]" filter-group="4">
            <groupfilter function="level-members" level="[none:commodity:nk]" user:ui-enumeration="all" user:ui-marker="enumerate" />
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#2a2a33" />
            <format attr="omit-on-special" value="true" />
            <format attr="break-on-special" value="true" />
            <format attr="show-null-value-warning" value="false" />
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#2a2a33" />
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
            <format attr="border-style" scope="cols" value="none" />
            <format attr="band-color" scope="rows" value="#2a2a33" />
            <format attr="band-color" scope="cols" value="#2a2a33" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#a3a3b0" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="header">
            <format attr="background-color" value="#2a2a33" />
            <format attr="border-style" scope="rows" value="none" />
