            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run fontsize="9">Top score</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontcolor="#a3a3b0" fontsize="10">Highest risk score
</run>
                <run bold="true" fontcolor="#f2f2f5" fontsize="24" fontname="Tableau Semibold">&lt;[awards].[max:risk_score:qk]&gt;
</run>
                <run fontcolor="#a3a3b0" fontsize="9">out of 100</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="Card: checks">
      <table>
        <view>
          <datasources>
            <datasource caption="Headline" name="headline" />
          </datasources>
          <datasource-dependencies datasource="headline">
            <column caption="Checks matching" datatype="integer" name="[checks_matching]" role="measure" type="quantitative" />
            <column caption="Checks" datatype="integer" name="[checks_total]" role="measure" type="quantitative" />
            <column-instance column="[checks_matching]" derivation="Sum" name="[sum:checks_matching:qk]" pivot="key" type="quantitative" />
            <column-instance column="[checks_total]" derivation="Sum" name="[sum:checks_total:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="table">
